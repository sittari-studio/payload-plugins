{
  "name": "sittari-payload-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:plugins": "turbo run dev --filter='./packages/*'",
    "test": "turbo test --filter='./packages/*'",
    "typecheck": "turbo typecheck --filter='./packages/*'",
    "clean": "turbo clean --filter='./packages/*' && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "release": "turbo build --filter='./packages/*' && changeset publish",
    "create:plugin": "node scripts/create-plugin.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "0.22.2",
    "turbo": "latest",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
