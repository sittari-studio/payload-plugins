{
  "name": "@sittari/payload-strings",
  "version": "0.2.0",
  "description": "Developer-defined UI strings global for Payload CMS with scoped tabs and localized text fields.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/exports/types.d.ts",
      "import": "./dist/exports/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js",
    "build:js": "tsc -p tsconfig.build.json --declaration false --declarationMap false",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:int",
    "test:int": "vitest run",
    "dev": "node ../../scripts/dev-package.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "payload": "^4.0.0-0"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "4.0.0-canary.33",
    "payload": "4.0.0-canary.33",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "cms",
    "strings",
    "i18n"
  ]
}
