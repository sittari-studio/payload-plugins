{
  "name": "@sittari/payload-rbac",
  "version": "0.1.0",
  "description": "Role-based access control plugin for PayloadCMS. Forked from @whatworks/payload-rbac with English, Ukrainian, and Russian admin localization.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "FORK.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js",
    "build:js": "tsc -p tsconfig.build.json --declaration false --declarationMap false",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:int",
    "test:int": "vitest run",
    "dev": "node ../../scripts/dev-package.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@payloadcms/ui": "^3.27.0"
  },
  "peerDependencies": {
    "payload": ">=3.27.0 <4",
    "react": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "payload": "^3.27.0",
    "react": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roxxel/krameri-payload-plugins.git",
    "directory": "packages/rbac"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "rbac",
    "access-control"
  ]
}
