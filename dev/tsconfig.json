{
  "extends": "../tsconfig.base.json",
  "exclude": ["dist", "node_modules"],
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.mjs"
  ],
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@payload-config": ["./payload.config.ts"]
    }
  }
}
